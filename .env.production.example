NODE_ENV=production
NYXDOC_IMAGE=ghcr.io/getnyxdoc/nyxdoc:0.24.1
NYXDOC_UPDATE_CHANNEL=stable
BETTER_AUTH_URL=http://localhost:3191
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_TRUSTED_ORIGINS=http://localhost:3191

REGISTRATION_MODE=invite
EMAIL_DOMAIN_POLICY=any
ALLOWED_EMAIL_DOMAINS=
EMAIL_VERIFICATION_ENABLED=false
NYXDOC_DIAGNOSTICS_ENABLED=true
NYXDOC_DIAGNOSTIC_RETENTION_DAYS=30

NYXDOC_COLLABORATION_SECRET=replace-with-a-different-32-byte-random-value
NYXDOC_COLLABORATION_PUBLIC_URL=ws://localhost:3191/collaboration
NYXDOC_HTTP_HOST=127.0.0.1
NYXDOC_HTTP_PORT=3191
NYXDOC_COLLABORATION_HOST_PORT=3192
NYXDOC_BACKUP_HOST_PATH=./data/backups

NYXDOC_SITE_OWNER_EMAIL=
NYXDOC_SITE_ADMIN_EMAILS=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
