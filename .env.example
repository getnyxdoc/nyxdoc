# Local defaults. Copy this file to .env.local for development or
# .env.production for Docker Compose.
NYXDOC_DB_PATH=./data/nyxdoc-dev.db
NYXDOC_MEDIA_ROOT=./data/media
NYXDOC_BACKUP_ROOT=./data/backups
NYXDOC_SOURCE_REVISION=local-development
BETTER_AUTH_URL=http://localhost:3100
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# The first account becomes the site owner. After that, invite is the
# recommended default; set open only when anyone should be allowed to sign up.
REGISTRATION_MODE=invite
EMAIL_DOMAIN_POLICY=any
ALLOWED_EMAIL_DOMAINS=
EMAIL_VERIFICATION_ENABLED=false

# Disable all new in-app bug/diagnostic collection when required. Existing
# records remain available to the local diagnostics CLI until they expire.
NYXDOC_DIAGNOSTICS_ENABLED=true
NYXDOC_DIAGNOSTIC_RETENTION_DAYS=30

# Optional owner override for restored or pre-existing installations.
NYXDOC_SITE_OWNER_EMAIL=
# Optional additional site administrators.
NYXDOC_SITE_ADMIN_EMAILS=

# Shared Yjs draft service. Use a separate random secret in production.
NYXDOC_COLLABORATION_SECRET=replace-with-another-32-byte-random-value
NYXDOC_COLLABORATION_PORT=3101
NYXDOC_COLLABORATION_INTERNAL_URL=http://127.0.0.1:3101
NYXDOC_COLLABORATION_PUBLIC_URL=ws://127.0.0.1:3101

# Docker Compose host bindings.
NYXDOC_IMAGE=nyxdoc-app:latest
NYXDOC_HTTP_HOST=127.0.0.1
NYXDOC_HTTP_PORT=3191
NYXDOC_COLLABORATION_HOST_PORT=3192

# Optional transactional email. Leave these blank for a no-mail installation;
# owners can still create one-time invitation and password-recovery links.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Docker Compose host backup path. Relative paths are resolved from the
# directory containing compose.yaml.
NYXDOC_BACKUP_HOST_PATH=./data/backups
